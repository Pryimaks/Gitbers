<!-- SEARCH SCRIPT -->
<!-- ========================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("teamSearch");

        const clearButton =
            document.getElementById("clearSearch");

        const teamItems =
            document.querySelectorAll(".team-item");

        const noResults =
            document.getElementById("noSearchResults");


        if (!searchInput) {
            return;
        }


        function searchTeams() {

            const search =
                searchInput.value
                    .toLowerCase()
                    .trim();

            let visibleCount = 0;


            teamItems.forEach(function (item) {

                const name =
                    item.getAttribute("data-team-name") || "";


                if (name.includes(search)) {

                    item.style.display = "";

                    visibleCount++;

                }
                else {

                    item.style.display = "none";

                }

            });


            if (noResults) {

                noResults.style.display =
                    visibleCount === 0
                        ? "block"
                        : "none";

            }


            if (clearButton) {

                clearButton.style.display =
                    search.length > 0
                        ? "flex"
                        : "none";

            }

        }


        searchInput.addEventListener(
            "input",
            searchTeams
        );


        if (clearButton) {

            clearButton.addEventListener(
                "click",
                function () {

                    searchInput.value = "";

                    searchTeams();

                    searchInput.focus();

                }
            );

        }

    });

</script>
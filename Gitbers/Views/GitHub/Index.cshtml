@model Gitbers.Services.GitHubUser

@{
    ViewData["Title"] = "GitHub";
}

<div class="container mt-4">

    <h1 class="mb-4">GitHub API</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title">
                Перевірка GitHub користувача
            </h5>

            <p class="text-muted">
                Введіть GitHub username, щоб отримати інформацію через GitHub API.
            </p>

            <form asp-controller="GitHub"
                  asp-action="Index"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="username" class="form-label">
                        GitHub username
                    </label>

                    <input type="text"
                           id="username"
                           name="username"
                           class="form-control"
                           placeholder="Наприклад: octocat"
                           value="@ViewBag.Username" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Перевірити
                </button>

            </form>

        </div>
    </div>


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }


    @if (Model != null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h4 class="card-title mb-3">
                    Інформація про користувача
                </h4>

                <div class="row">

                    <div class="col-md-6">

                        <p>
                            <strong>Username:</strong>
                            @Model.Login
                        </p>

                        <p>
                            <strong>Ім'я:</strong>
                            @(Model.Name ?? "Не вказано")
                        </p>

                    </div>

                    <div class="col-md-6">

                        <p>
                            <strong>Публічних репозиторіїв:</strong>
                            @Model.PublicRepositories
                        </p>

                        <p>
                            <strong>Підписників:</strong>
                            @Model.Followers
                        </p>

                        <p>
                            <strong>Підписок:</strong>
                            @Model.Following
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <div class="card shadow-sm">

            <div class="card-body">

                <h4 class="card-title mb-3">
                    Репозиторії
                </h4>

                @if (ViewBag.Repositories != null &&
                     ViewBag.Repositories.Count > 0)
                {
                    <div class="table-responsive">

                        <table class="table table-hover">

                            <thead>
                                <tr>
                                    <th>Назва</th>
                                    <th>Повне ім'я</th>
                                    <th>Власник</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var repository in ViewBag.Repositories)
                                {
                                    <tr>
                                        <td>
                                            @repository.Name
                                        </td>

                                        <td>
                                            @repository.FullName
                                        </td>

                                        <td>
                                            @repository.Owner?.Login
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <p class="text-muted">
                        Публічних репозиторіїв не знайдено.
                    </p>
                }

            </div>

        </div>
    }

</div>
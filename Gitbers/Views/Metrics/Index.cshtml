@model Gitbers.Models.MetricSnapshot?

@{
    ViewData["Title"] = "Метрики команди";

    var team = ViewBag.Team as Gitbers.Models.Team;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Метрики команди</h1>

            <p class="text-muted mb-0">
                Команда:
                <strong>@team?.Name</strong>
            </p>
        </div>

        <a asp-controller="GitHub"
           asp-action="Team"
           asp-route-id="@team?.TeamId"
           class="btn btn-secondary">
            GitHub активність
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- Кнопка розрахунку -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h4 class="mb-2">
                Аналіз психологічного клімату
            </h4>

            <p class="text-muted">
                Розрахунок показників виконується на основі
                GitHub активності команди за останні 7 днів.
            </p>

            <form asp-controller="Metrics"
                  asp-action="Calculate"
                  asp-route-id="@team?.TeamId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary">
                    Розрахувати метрики
                </button>

            </form>

        </div>

    </div>


    @if (Model != null)
    {
        <!-- Період -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h5>
                    Період аналізу
                </h5>

                <p class="mb-0">
                    <strong>
                        @Model.PeriodStart.ToString("dd.MM.yyyy HH:mm")
                    </strong>

                    —

                    <strong>
                        @Model.PeriodEnd.ToString("dd.MM.yyyy HH:mm")
                    </strong>
                </p>

                <small class="text-muted">
                    Розраховано:
                    @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                </small>

            </div>

        </div>


        <!-- Основні показники -->

        <div class="row g-4 mb-4">

            <!-- Activity -->

            <div class="col-md-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h4>
                            Activity Score
                        </h4>

                        <div class="display-5 fw-bold mb-3">
                            @Model.ActivityScore
                        </div>

                        <div class="progress"
                             style="height: 20px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @Model.ActivityScore%;">
                            </div>

                        </div>

                        <p class="text-muted mt-3 mb-0">
                            Інтенсивність роботи команди
                            за GitHub активністю.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Collaboration -->

            <div class="col-md-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h4>
                            Collaboration Score
                        </h4>

                        <div class="display-5 fw-bold mb-3">
                            @Model.CollaborationScore
                        </div>

                        <div class="progress"
                             style="height: 20px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @Model.CollaborationScore%;">
                            </div>

                        </div>

                        <p class="text-muted mt-3 mb-0">
                            Рівень командної взаємодії
                            через Pull Requests та Code Reviews.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Stability -->

            <div class="col-md-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h4>
                            Stability Score
                        </h4>

                        <div class="display-5 fw-bold mb-3">
                            @Model.StabilityScore
                        </div>

                        <div class="progress"
                             style="height: 20px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @Model.StabilityScore%;">
                            </div>

                        </div>

                        <p class="text-muted mt-3 mb-0">
                            Рівномірність розподілу активності
                            між учасниками команди.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Risk -->

            <div class="col-md-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h4>
                            Risk Score
                        </h4>

                        <div class="display-5 fw-bold mb-3">
                            @Model.RiskScore
                        </div>

                        <div class="progress"
                             style="height: 20px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @Model.RiskScore%;">
                            </div>

                        </div>

                        <p class="mt-3 mb-0">

                            Рівень ризику:

                            <strong>
                                @switch (Model.RiskLevel)
                                {
                                    case "Low":
                                        <span>Низький</span>
                                        break;

                                    case "Medium":
                                        <span>Середній</span>
                                        break;

                                    case "High":
                                        <span>Високий</span>
                                        break;

                                    default:
                                        <span>@Model.RiskLevel</span>
                                        break;
                                }
                            </strong>

                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- Інтерпретація -->

        <div class="card shadow-sm">

            <div class="card-body">

                <h4 class="mb-3">
                    Результат аналізу
                </h4>

                <p>
                    Система сформувала комплексні показники
                    командної активності, взаємодії та стабільності.
                </p>

                <p class="mb-0 text-muted">
                    Отримані значення є аналітичними індикаторами
                    на основі даних GitHub і не є психологічним
                    діагнозом окремих учасників.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- Немає результату -->

        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>
                    Метрики ще не розраховані
                </h4>

                <p class="text-muted">
                    Спочатку синхронізуйте GitHub активність,
                    після чого виконайте розрахунок метрик.
                </p>

                <a asp-controller="GitHub"
                   asp-action="Team"
                   asp-route-id="@team?.TeamId"
                   class="btn btn-primary">
                    Перейти до GitHub активності
                </a>

            </div>

        </div>
    }

</div>
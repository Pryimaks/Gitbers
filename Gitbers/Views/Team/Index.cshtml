@model IEnumerable<Gitbers.Models.Team>

@{
    ViewData["Title"] = "Команди";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Команди</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Створити команду
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Команд поки немає.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var team in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body">

                            <h3 class="card-title">
                                @team.Name
                            </h3>

                            <p class="card-text">
                                @team.Description
                            </p>

                            @if (!string.IsNullOrEmpty(team.GitHubOrganization))
                            {
                                <p>
                                    <strong>GitHub:</strong>
                                    @team.GitHubOrganization
                                </p>
                            }

                            <p>
                                Учасників:
                                @team.Members.Count
                            </p>

                            <div class="mt-3">
                                <a asp-action="Details"
                                   asp-route-id="@team.TeamId"
                                   class="btn btn-outline-primary">
                                    Переглянути
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@team.TeamId"
                                   class="btn btn-outline-secondary">
                                    Редагувати
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@team.TeamId"
                                   class="btn btn-outline-danger">
                                    Видалити
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
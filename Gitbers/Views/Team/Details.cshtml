@model Gitbers.Models.Team

@{
    ViewData["Title"] = "Команда";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Model.Name</h1>

    <a asp-action="Index" class="btn btn-secondary">
        Назад
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <h4>Інформація про команду</h4>

        <p>
            <strong>Назва:</strong>
            @Model.Name
        </p>

        <p>
            <strong>Опис:</strong>
            @Model.Description
        </p>

        <p>
            <strong>GitHub Organization:</strong>
            @Model.GitHubOrganization
        </p>

        <p>
            <strong>Створено:</strong>
            @Model.CreatedAt.ToString("dd.MM.yyyy")
        </p>

    </div>
</div>


<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Учасники команди</h2>

    <div class="d-flex gap-2">

        <a asp-action="AddMember"
           asp-route-id="@Model.TeamId"
           class="btn btn-primary">
            + Додати учасника
        </a>

        <a asp-controller="GitHub"
           asp-action="Team"
           asp-route-id="@Model.TeamId"
           class="btn btn-dark">
            GitHub активність
        </a>

    </div>

</div>


@if (Model.Members.Any())
{
    <div class="table-responsive">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Користувач</th>
                    <th>Email</th>
                    <th>GitHub username</th>
                    <th>Viber</th>
                    <th>Дата додавання</th>
                    <th style="width: 180px;">Дія</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var member in Model.Members)
                {
                    <tr>

                        <td>
                            @(member.User?.FullName ?? "Без імені")
                        </td>

                        <td>
                            @member.User?.Email
                        </td>

                        <td>
                            <code>@member.GitHubUsername</code>
                        </td>

                        <td>

                            @if (member.ViberConnected)
                            {
                                <span class="badge bg-success">
                                    Підключено
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(member.PhoneNumber))
                            {
                                <span class="badge bg-warning text-dark">
                                    Очікує підключення
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Не налаштовано
                                </span>
                            }

                        </td>

                        <td>
                            @member.AddedAt.ToString("dd.MM.yyyy")
                        </td>

                        <td>

                            @if (string.IsNullOrWhiteSpace(member.PhoneNumber))
                            {
                                <a asp-action="ConnectViber"
                                   asp-route-id="@member.TeamMemberId"
                                   class="btn btn-sm btn-primary">
                                    Підключити Viber
                                </a>
                            }
                            else
                            {
                                <a asp-action="ConnectViber"
                                   asp-route-id="@member.TeamMemberId"
                                   class="btn btn-sm btn-outline-primary">
                                    Змінити номер
                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}
else
{
    <div class="alert alert-info">
        У цій команді ще немає учасників.
    </div>
}